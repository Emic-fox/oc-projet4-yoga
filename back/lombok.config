# Racine de configuration Lombok pour le module.
config.stopBubbling = true

# Annote le code généré par Lombok avec @lombok.Generated : JaCoCo (>= 0.8) l'exclut
# alors automatiquement des rapports de couverture (getters/setters, equals/hashCode,
# toString, builders...).
lombok.addLombokGeneratedAnnotation = true
